{
  "schema_version": "1.0",
  "kind": "route_experiment_cases",
  "note": "Tasks name only the intended change. Oracles live in oracles/ and never enter a workspace.",
  "agent_edit_version": "0.8.1",
  "agent_map_version": "0.24.0",
  "cases": [
    {
      "id": "fixture-rename",
      "kind": "adversarial",
      "source": {
        "type": "benchmark_fixture"
      },
      "task": "tasks/fixture-rename.md",
      "oracle": "oracles/fixture.php",
      "allowed_paths": [
        "src/Invoice.php",
        "src/Checkout.php",
        "src/Report.php"
      ],
      "expected_route": "map+edit"
    },
    {
